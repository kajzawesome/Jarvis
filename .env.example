# Copy this file to .env and fill in real values. .env is where any node
# that needs a secret/credential reads from (see twitch/README.md for the
# twitch ones specifically).

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
# TWITCH_USER_ACCESS_TOKEN / TWITCH_USER_REFRESH_TOKEN - don't fill these in
# by hand, the "CONNECT FOR FOLLOWERS/SUBS" button on the tile writes them
# for you after a one-time browser authorization.

# ASUS RT-AX1800S admin login (see router-network/README.md)
ROUTER_HOST=192.168.50.1
ROUTER_USER=
ROUTER_PASSWORD=

# GITHUB_TOKEN is optional (see github-activity/README.md)
GITHUB_USERNAME=
GITHUB_TOKEN=

# see spotify/README.md
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# see streamlabs/README.md
STREAMLABS_API_TOKEN=

# see google-calendar/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# minecraft-server is built for one specific self-hosted setup (a Docker
# Compose stack with a Paper container + a relay tunnel-client - see
# minecraft-server/README.md). Point this at the folder containing that
# stack's docker-compose.yml, or leave it blank if that's not your setup -
# the tile just shows "not configured" instead of erroring.
MC_HOME_STACK_DIR=

# rgb-control: path to OpenRGB.exe (only needed for the LAUNCH OPENRGB
# button when it's not already running - the SDK connection itself doesn't
# need this). Leave blank to just not show that button.
OPENRGB_EXE_PATH=
